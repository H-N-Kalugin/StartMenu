// Ресурсы exe: иконка (её видно в Проводнике, на панели задач, в ярлыках) и сведения о версии.
#pragma code_page(65001)
#include <winver.h>

IDI_ICON1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,1,0
 PRODUCTVERSION 1,0,1,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "CompanyName", "StartMenu"
            VALUE "FileDescription", "StartMenu — своё меню «Пуск»"
            VALUE "FileVersion", "1.0.1"
            VALUE "InternalName", "StartMenu"
            VALUE "OriginalFilename", "StartMenu.exe"
            VALUE "ProductName", "StartMenu"
            VALUE "ProductVersion", "1.0.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
